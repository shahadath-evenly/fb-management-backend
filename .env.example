# --- Used when running the app directly with `npm run dev` ---
PORT=5001
NODE_ENV=development

DATABASE_URL="postgresql://YOUR_OS_USERNAME@localhost:5432/fnb_management?schema=public"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="14d"

FRONTEND_URL="http://localhost:3000"

# --- Used only by `docker compose up` (docker-compose.yml in this
# directory) — ignored when running the app directly. DATABASE_URL
# above is not reused for Docker: the backend container builds its
# own connection string from POSTGRES_* below, pointed at the `db`
# service instead of localhost. ---
POSTGRES_USER=fnb_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=fnb_management
BACKEND_PORT=5001

# Initial HQ admin account — created automatically on first boot if no
# user with this email exists yet (safe on every restart; a no-op
# once it exists). Change both before any real/public deployment.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Test123@@
