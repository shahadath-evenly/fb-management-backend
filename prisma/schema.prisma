generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  staff
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole
  outletId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([outletId])
  @@index([role])
}

model Outlet {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  outletMenus    OutletMenu[]
  inventory      OutletInventory[]
  sales          Sale[]
  receiptCounter OutletReceiptCounter?
}

model MasterMenu {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  basePrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outletMenus OutletMenu[]
  inventory   OutletInventory[]
  saleItems   SaleItem[]
}

model OutletMenu {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @db.Uuid
  menuId    String   @db.Uuid
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  menu   MasterMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([outletId, menuId])
  @@index([outletId])
  @@index([menuId])
}

model OutletInventory {
  id        String   @id @default(uuid()) @db.Uuid
  outletId  String   @db.Uuid
  menuId    String   @db.Uuid
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  menu   MasterMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@unique([outletId, menuId])
  @@index([outletId])
  @@index([menuId])
}

model Sale {
  id            String   @id @default(uuid()) @db.Uuid
  outletId      String   @db.Uuid
  receiptNumber Int
  totalAmount   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet Outlet     @relation(fields: [outletId], references: [id], onDelete: Restrict)
  items  SaleItem[]

  @@unique([outletId, receiptNumber])
  @@index([outletId])
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  menuId    String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  menu MasterMenu @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([menuId])
}

model OutletReceiptCounter {
  id         String @id @default(uuid()) @db.Uuid
  outletId   String @unique @db.Uuid
  lastNumber Int    @default(0)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
}
