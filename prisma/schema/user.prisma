enum UserRole {
  admin
  staff
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole
  outletId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([outletId])
  @@index([role])
}
